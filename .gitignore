.config/dolphinrc
.config/katevirc
.config/kdeglobals
.config/kiorc
.config/krename.kmessagebox
.config/krenamerc
.config/ktrashrc
.config/okularpartrc
.config/okularrc
.config/pavucontrol.ini
.config/trashrc
